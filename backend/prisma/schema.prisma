generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int               @id @default(autoincrement())
  email          String?           @unique
  password       String
  name           String?
  role           Role              @default(USER)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tokenVersionAt DateTime          @default(now())
  username       String            @unique
  commissionLog  Commission[]
  purchases      Purchase[]
  refreshToken   RefreshToken[]
  sales          Sale[]
  commissions    SalesCommission[]
}

model CommissionLevel {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?
  active      Boolean           @default(true)
  priceListId Int?
  priceList   PriceList?        @relation(fields: [priceListId], references: [id])
  commissions SalesCommission[]
}

model SalesCommission {
  id      Int             @id @default(autoincrement())
  userId  Int
  levelId Int
  percent Decimal         @db.Decimal(5, 2)
  active  Boolean         @default(true)
  level   CommissionLevel @relation(fields: [levelId], references: [id])
  user    User            @relation(fields: [userId], references: [id])

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
}

model Commission {
  id         Int            @id @default(autoincrement())
  userId     Int
  saleId     Int
  saleItemId Int?
  percent    Decimal        @db.Decimal(5, 2)
  amount     Decimal        @db.Decimal(12, 2)
  type       CommissionType
  createdAt  DateTime       @default(now())
  sale       Sale           @relation(fields: [saleId], references: [id])
  saleItem   SaleItem?      @relation(fields: [saleItemId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([saleId])
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Customer {
  id         Int                   @id @default(autoincrement())
  name       String
  email      String?               @unique
  phone      String?
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  dni        String?
  receivable AccountReceivable[]
  points     LoyaltyPoint?
  history    LoyaltyPointHistory[]
  sales      Sale[]
}

model AccountReceivable {
  id         Int                 @id @default(autoincrement())
  saleId     Int                 @unique
  customerId Int
  total      Decimal             @db.Decimal(10, 2)
  paidAmount Decimal             @default(0) @db.Decimal(10, 2)
  balance    Decimal             @db.Decimal(10, 2)
  dueDate    DateTime?
  status     AccountStatus       @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  customer   Customer            @relation(fields: [customerId], references: [id])
  sale       Sale                @relation(fields: [saleId], references: [id])
  payments   ReceivablePayment[]
}

model ReceivablePayment {
  id          Int               @id @default(autoincrement())
  accountId   Int
  amount      Decimal           @db.Decimal(10, 2)
  paymentDate DateTime          @default(now())
  note        String?
  account     AccountReceivable @relation(fields: [accountId], references: [id])
}

model Barcode {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model Product {
  id            Int            @id @default(autoincrement())
  sku           String         @unique
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  cost          Decimal        @db.Decimal(10, 2)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categoryId    Int
  tax           Decimal        @default(0) @db.Decimal(5, 2)
  reorderPoint  Int            @default(0)
  barcodes      Barcode[]
  category      Category       @relation(fields: [categoryId], references: [id])
  prices        ProductPrice[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
}

model PriceList {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  active           Boolean           @default(true)
  commissionLevels CommissionLevel[]
  prices           ProductPrice[]
  sale             Sale[]
}

model ProductPrice {
  id          Int       @id @default(autoincrement())
  productId   Int
  priceListId Int
  price       Decimal   @db.Decimal(10, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([productId, priceListId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  active    Boolean    @default(true)
  parentId  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@unique([name, parentId])
}

model Supplier {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  email     String?
  phone     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  rtn       String?
  payable   AccountPayable[]
  purchases Purchase[]
}

model AccountPayable {
  id         Int              @id @default(autoincrement())
  purchaseId Int              @unique
  supplierId Int
  total      Decimal          @db.Decimal(10, 2)
  paidAmount Decimal          @default(0) @db.Decimal(10, 2)
  balance    Decimal          @db.Decimal(10, 2)
  dueDate    DateTime?
  status     AccountStatus    @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  purchase   Purchase         @relation(fields: [purchaseId], references: [id])
  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  payments   PayablePayment[]
}

model PayablePayment {
  id          Int            @id @default(autoincrement())
  accountId   Int
  amount      Decimal        @db.Decimal(10, 2)
  paymentDate DateTime       @default(now())
  note        String?
  account     AccountPayable @relation(fields: [accountId], references: [id])
}

model Purchase {
  id            Int             @id @default(autoincrement())
  total         Decimal         @db.Decimal(10, 2)
  userId        Int?
  createdAt     DateTime        @default(now())
  supplierId    Int
  warehouseId   Int
  paymentMethod PaymentMethod   @default(CASH)
  payable       AccountPayable?
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  user          User?           @relation(fields: [userId], references: [id])
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  items         PurchaseItem[]
}

model PurchaseItem {
  id          Int           @id @default(autoincrement())
  purchaseId  Int
  productId   Int
  quantity    Int
  cost        Decimal       @db.Decimal(10, 2)
  expiresAt   DateTime?
  warehouseId Int
  product     Product       @relation(fields: [productId], references: [id])
  purchase    Purchase      @relation(fields: [purchaseId], references: [id])
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  saleItems   SaleItemLot[]
}

model SaleSequence {
  id          Int       @id @default(autoincrement())
  current     Int       @default(0)
  warehouseId Int       @unique
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model SaleItemLot {
  saleItemId     Int
  purchaseItemId Int
  quantity       Int
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id])

  @@id([saleItemId, purchaseItemId])
}

model InventoryLedger {
  id            BigInt                @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  type          InventoryMovementType
  quantity      Int
  movementValue Decimal               @db.Decimal(20, 6)
  referenceType String?
  referenceId   Int?
  createdAt     DateTime              @default(now())
  createdBy     Int?
  note          String?

  @@index([productId, warehouseId, createdAt, id], map: "idx_ledger_kardex")
}

model Sale {
  id            Int                   @id @default(autoincrement())
  saleNumber    String                @unique
  status        SaleStatus            @default(COMPLETED)
  subtotal      Decimal               @db.Decimal(10, 2)
  discount      Decimal               @default(0) @db.Decimal(10, 2)
  total         Decimal               @db.Decimal(10, 2)
  pointsUsed    Int                   @default(0)
  pointsEarned  Int                   @default(0)
  customerId    Int?
  userId        Int
  createdAt     DateTime              @default(now())
  warehouseId   Int
  cogs          Decimal               @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod         @default(CASH)
  grossSubtotal Decimal               @db.Decimal(12, 2)
  priceListId   Int?
  taxTotal      Decimal               @default(0)
  receivable    AccountReceivable?
  commissions   Commission[]
  history       LoyaltyPointHistory[]
  customer      Customer?             @relation(fields: [customerId], references: [id])
  priceList     PriceList?            @relation(fields: [priceListId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id                Int           @id @default(autoincrement())
  saleId            Int
  productId         Int
  quantity          Int
  price             Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  discountType      DiscountType  @default(NONE)
  discountValue     Decimal       @default(0) @db.Decimal(12, 2)
  lineSubtotal      Decimal       @db.Decimal(12, 2)
  commissionAmount  Decimal?      @db.Decimal(10, 2)
  commissionPercent Decimal?      @db.Decimal(5, 2)
  priceListId       Int?
  lineTotal         Decimal       @default(0)
  tax               Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal       @default(0)
  commissions       Commission[]
  product           Product       @relation(fields: [productId], references: [id])
  sale              Sale          @relation(fields: [saleId], references: [id])
  lots              SaleItemLot[]
}

model LoyaltyPoint {
  id         Int                   @id @default(autoincrement())
  customerId Int                   @unique
  balance    Int                   @default(0)
  customer   Customer              @relation(fields: [customerId], references: [id])
  history    LoyaltyPointHistory[] @relation("LoyaltyPointToLoyaltyPointHistory")
}

model LoyaltyPointHistory {
  id          Int            @id @default(autoincrement())
  customerId  Int
  saleId      Int?
  change      Int
  description String
  createdAt   DateTime       @default(now())
  customer    Customer       @relation(fields: [customerId], references: [id])
  sale        Sale?          @relation(fields: [saleId], references: [id])
  loyalty     LoyaltyPoint[] @relation("LoyaltyPointToLoyaltyPointHistory")
}

model Warehouse {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  purchase     Purchase[]
  items        PurchaseItem[]
  sale         Sale[]
  saleSequence SaleSequence?
}

enum CommissionType {
  SALE
  REVERSAL
}

enum Role {
  ADMIN
  USER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AccountStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}
