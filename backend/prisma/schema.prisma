generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              Int               @id @default(autoincrement())
  name            String
  active          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  slug            String            @unique
  deletedAt       DateTime?
  inviteOnly      Boolean           @default(true)
  maxUsers        Int               @default(5)
  maxWarehouses   Int               @default(2)
  registrationKey String?           @unique
  updatedAt       DateTime?         @updatedAt
  verified        Boolean           @default(false)
  categories      Category[]
  commissions     Commission[]
  commissionLevel CommissionLevel[]
  customers       Customer[]
  fiscalConfigs   FiscalConfig[]
  priceLists      PriceList[]
  products        Product[]
  productPrice    ProductPrice[]
  purchases       Purchase[]
  quotations      Quotation[]
  remissions      Remission[]
  reportTemplate  ReportTemplate[]
  sales           Sale[]
  salesCommission SalesCommission[]
  suppliers       Supplier[]
  systemConfig    SystemConfig[]
  users           User[]
  warehouses      Warehouse[]
}

model TenantInvite {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  email     String?
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model User {
  id                 Int               @id @default(autoincrement())
  tenantId           Int
  username           String
  password           String
  name               String?
  role               Role              @default(USER)
  active             Boolean           @default(true)
  tokenVersionAt     DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  warehouseId        Int?
  commissionLog      Commission[]
  fiscalConfigs      FiscalConfig[]
  purchases          Purchase[]
  quotationsAsSeller Quotation[]       @relation("QuotationSeller")
  quotations         Quotation[]       @relation("QuotationCreator")
  refreshToken       RefreshToken[]
  remissions         Remission[]
  salesAsSeller      Sale[]            @relation("SaleSeller")
  sales              Sale[]            @relation("SaleCreator")
  saleReturns        SaleReturn[]
  commissions        SalesCommission[]
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  userSaleSequence   UserSaleSequence?

  @@unique([tenantId, username])
  @@index([tenantId])
}

model PriceList {
  id               Int               @id @default(autoincrement())
  tenantId         Int
  name             String
  description      String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  commissionLevels CommissionLevel[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  prices           ProductPrice[]
  quotations       Quotation[]
  sales            Sale[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductPrice {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  productId   Int
  priceListId Int
  price       Decimal   @db.Decimal(10, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, priceListId])
  @@index([tenantId])
}

model CommissionLevel {
  id          Int               @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?
  active      Boolean           @default(true)
  priceListId Int?
  priceList   PriceList?        @relation(fields: [priceListId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  commissions SalesCommission[]

  @@unique([tenantId, name])
}

model SalesCommission {
  id       Int             @id @default(autoincrement())
  tenantId Int
  userId   Int
  levelId  Int
  percent  Decimal         @db.Decimal(5, 2)
  active   Boolean         @default(true)
  level    CommissionLevel @relation(fields: [levelId], references: [id])
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  user     User            @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, levelId])
  @@index([tenantId])
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

model Commission {
  id         Int            @id @default(autoincrement())
  tenantId   Int
  userId     Int
  saleId     Int
  saleItemId Int?
  percent    Decimal        @db.Decimal(5, 2)
  amount     Decimal        @db.Decimal(12, 2)
  type       CommissionType
  createdAt  DateTime       @default(now())
  sale       Sale           @relation(fields: [saleId], references: [id])
  saleItem   SaleItem?      @relation(fields: [saleItemId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, userId])
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Customer {
  id          Int                   @id @default(autoincrement())
  tenantId    Int
  name        String
  email       String?
  phone       String?
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  dni         String?
  direction   String?
  creditLimit Decimal?              @db.Decimal(10, 2)
  receivable  AccountReceivable[]
  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  points      LoyaltyPoint?
  history     LoyaltyPointHistory[]
  quotations  Quotation[]
  sales       Sale[]

  @@unique([tenantId, email, dni])
  @@index([tenantId])
}

model Supplier {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  name      String
  email     String?
  phone     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  payable   AccountPayable[]
  purchases Purchase[]
  tenant    Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id        Int        @id @default(autoincrement())
  tenantId  Int
  name      String
  parentId  Int?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([tenantId, name, parentId])
  @@index([tenantId])
}

model Product {
  id                 Int                 @id @default(autoincrement())
  tenantId           Int
  sku                String
  name               String
  description        String?
  price              Decimal             @db.Decimal(10, 2)
  cost               Decimal             @db.Decimal(10, 2)
  active             Boolean             @default(true)
  categoryId         Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reorderPoint       Int                 @default(0)
  tax                Decimal             @default(0) @db.Decimal(5, 2)
  laboratory         String?
  observations       String?
  imageUrl           String?
  barcodes           Barcode[]
  inventoryMovements InventoryMovement[]
  category           Category            @relation(fields: [categoryId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  prices             ProductPrice[]
  purchaseItems      PurchaseItem[]
  quotationItems     QuotationItem[]
  remissionItems     RemissionItem[]
  saleItems          SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Barcode {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model Warehouse {
  id           Int                 @id @default(autoincrement())
  tenantId     Int
  name         String
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    InventoryMovement[]
  purchase     Purchase[]
  items        PurchaseItem[]
  quotations   Quotation[]
  remissions   Remission[]
  sale         Sale[]
  saleSequence SaleSequence?
  user         User[]
  tenant       Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model InventoryMovement {
  id          Int                   @id @default(autoincrement())
  tenantId    Int
  productId   Int
  warehouseId Int?
  type        InventoryMovementType
  quantity    Int
  note        String?
  createdAt   DateTime              @default(now())
  product     Product               @relation(fields: [productId], references: [id])
  warehouse   Warehouse?            @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
}

model InventoryLedger {
  id            BigInt                @id @default(autoincrement())
  tenantId      Int
  productId     Int
  warehouseId   Int
  type          InventoryMovementType
  quantity      Int
  movementValue Decimal               @db.Decimal(20, 6)
  referenceType String?
  referenceId   Int?
  createdAt     DateTime              @default(now())
  createdBy     Int?
  note          String?

  @@index([tenantId, productId, warehouseId, createdAt, id])
}

model Purchase {
  id             Int             @id @default(autoincrement())
  tenantId       Int
  total          Decimal         @db.Decimal(10, 2)
  userId         Int?
  supplierId     Int
  warehouseId    Int
  paymentMethod  PaymentMethod   @default(CASH)
  createdAt      DateTime        @default(now())
  status         PurchaseStatus  @default(ACTIVE)
  purchaseNumber String?
  payable        AccountPayable?
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  items          PurchaseItem[]

  @@index([tenantId])
}

model PurchaseItem {
  id          Int           @id @default(autoincrement())
  tenantId    Int
  purchaseId  Int
  productId   Int
  quantity    Int
  cost        Decimal       @db.Decimal(10, 2)
  expiresAt   DateTime?
  warehouseId Int
  lotNumber   String?
  product     Product       @relation(fields: [productId], references: [id])
  purchase    Purchase      @relation(fields: [purchaseId], references: [id])
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  saleItems   SaleItemLot[]

  @@index([tenantId])
}

model SaleSequence {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  current     BigInt    @default(0)
  warehouseId Int       @unique
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
}

model FiscalConfig {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  cai           String
  establishment String   @default("001")
  emissionPoint String   @default("001")
  documentType  String   @default("01")
  rangeStart    String
  rangeEnd      String
  expiresAt     DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        Int?
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])
  sales         Sale[]

  @@index([tenantId])
}

model UserSaleSequence {
  id       Int    @id @default(autoincrement())
  tenantId Int
  userId   Int    @unique
  current  BigInt @default(0)
  user     User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model ReportTemplate {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?
  config      Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Sale {
  id             Int                   @id @default(autoincrement())
  tenantId       Int
  saleNumber     String
  status         SaleStatus            @default(COMPLETED)
  subtotal       Decimal               @db.Decimal(10, 2)
  discount       Decimal               @default(0) @db.Decimal(10, 2)
  total          Decimal               @db.Decimal(10, 2)
  grossSubtotal  Decimal               @db.Decimal(12, 2)
  cogs           Decimal               @default(0) @db.Decimal(10, 2)
  pointsUsed     Int                   @default(0)
  pointsEarned   Int                   @default(0)
  customerId     Int?
  userId         Int
  warehouseId    Int
  paymentMethod  PaymentMethod         @default(CASH)
  createdAt      DateTime              @default(now())
  priceListId    Int?
  sellerId       Int?
  taxTotal       Decimal               @default(0)
  priceMode      PriceMode             @default(TAX_INCLUDED)
  amountPaid     Decimal?              @db.Decimal(10, 2)
  changeAmount   Decimal?              @db.Decimal(10, 2)
  observations   String?
  fiscalConfigId Int?
  receivable     AccountReceivable?
  commissions    Commission[]
  history        LoyaltyPointHistory[]
  quotation      Quotation?
  customer       Customer?             @relation(fields: [customerId], references: [id])
  fiscalConfig   FiscalConfig?         @relation(fields: [fiscalConfigId], references: [id])
  priceList      PriceList?            @relation(fields: [priceListId], references: [id])
  seller         User?                 @relation("SaleSeller", fields: [sellerId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  user           User                  @relation("SaleCreator", fields: [userId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  items          SaleItem[]
  payments       SalePayment[]
  returns        SaleReturn[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId])
}

model SalePayment {
  id        Int           @id @default(autoincrement())
  saleId    Int
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  tenantId  Int
  sale      Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model SaleItem {
  id                Int              @id @default(autoincrement())
  saleId            Int
  productId         Int
  quantity          Int
  price             Decimal          @db.Decimal(12, 2)
  discountAmount    Decimal          @default(0) @db.Decimal(12, 2)
  discountType      DiscountType     @default(NONE)
  discountValue     Decimal          @default(0) @db.Decimal(12, 2)
  lineSubtotal      Decimal          @db.Decimal(12, 2)
  commissionAmount  Decimal?         @db.Decimal(10, 2)
  commissionPercent Decimal?         @db.Decimal(5, 2)
  priceListId       Int?
  tax               Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal          @default(0)
  lineTotal         Decimal          @default(0)
  observations      String?
  commissions       Commission[]
  product           Product          @relation(fields: [productId], references: [id])
  sale              Sale             @relation(fields: [saleId], references: [id])
  lots              SaleItemLot[]
  returnItems       SaleReturnItem[]
}

model SaleItemLot {
  saleItemId     Int
  purchaseItemId Int
  quantity       Int
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id])

  @@id([saleItemId, purchaseItemId])
}

model LoyaltyPoint {
  id         Int                   @id @default(autoincrement())
  tenantId   Int
  customerId Int                   @unique
  balance    Int                   @default(0)
  customer   Customer              @relation(fields: [customerId], references: [id])
  history    LoyaltyPointHistory[] @relation("LoyaltyPointToLoyaltyPointHistory")

  @@index([tenantId])
}

model LoyaltyPointHistory {
  id          Int            @id @default(autoincrement())
  tenantId    Int
  customerId  Int
  saleId      Int?
  change      Int
  description String
  createdAt   DateTime       @default(now())
  customer    Customer       @relation(fields: [customerId], references: [id])
  sale        Sale?          @relation(fields: [saleId], references: [id])
  loyalty     LoyaltyPoint[] @relation("LoyaltyPointToLoyaltyPointHistory")

  @@index([tenantId])
}

model AccountReceivable {
  id         Int                 @id @default(autoincrement())
  tenantId   Int
  saleId     Int                 @unique
  customerId Int
  total      Decimal             @db.Decimal(10, 2)
  paidAmount Decimal             @default(0) @db.Decimal(10, 2)
  balance    Decimal             @db.Decimal(10, 2)
  dueDate    DateTime?
  status     AccountStatus       @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  customer   Customer            @relation(fields: [customerId], references: [id])
  sale       Sale                @relation(fields: [saleId], references: [id])
  payments   ReceivablePayment[]

  @@index([tenantId])
}

model ReceivablePayment {
  id          Int               @id @default(autoincrement())
  accountId   Int
  amount      Decimal           @db.Decimal(10, 2)
  paymentDate DateTime          @default(now())
  note        String?
  account     AccountReceivable @relation(fields: [accountId], references: [id])
}

model AccountPayable {
  id         Int              @id @default(autoincrement())
  tenantId   Int
  purchaseId Int              @unique
  supplierId Int
  total      Decimal          @db.Decimal(10, 2)
  paidAmount Decimal          @default(0) @db.Decimal(10, 2)
  balance    Decimal          @db.Decimal(10, 2)
  dueDate    DateTime?
  status     AccountStatus    @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  purchase   Purchase         @relation(fields: [purchaseId], references: [id])
  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  payments   PayablePayment[]

  @@index([tenantId])
}

model PayablePayment {
  id          Int            @id @default(autoincrement())
  accountId   Int
  amount      Decimal        @db.Decimal(10, 2)
  paymentDate DateTime       @default(now())
  note        String?
  account     AccountPayable @relation(fields: [accountId], references: [id])
}

model SaleReturn {
  id        Int              @id @default(autoincrement())
  saleId    Int
  userId    Int
  reason    String?
  createdAt DateTime         @default(now())
  sale      Sale             @relation(fields: [saleId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  items     SaleReturnItem[]
}

model SaleReturnItem {
  id           Int        @id @default(autoincrement())
  returnId     Int
  saleItemId   Int
  quantity     Int
  refundAmount Decimal    @db.Decimal(12, 2)
  return       SaleReturn @relation(fields: [returnId], references: [id])
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
}

model Remission {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  remissionNumber String
  status          RemissionStatus @default(PENDING)
  warehouseId     Int
  userId          Int
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customerName    String?
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  items           RemissionItem[]

  @@unique([tenantId, remissionNumber])
  @@index([tenantId])
}

model RemissionItem {
  id          Int       @id @default(autoincrement())
  remissionId Int
  productId   Int
  quantity    Int
  note        String?
  product     Product   @relation(fields: [productId], references: [id])
  remission   Remission @relation(fields: [remissionId], references: [id])
}

model Quotation {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  quotationNumber String
  status          QuotationStatus @default(PENDING)
  subtotal        Decimal         @db.Decimal(10, 2)
  discount        Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  taxTotal        Decimal         @default(0)
  customerId      Int?
  userId          Int
  warehouseId     Int
  priceListId     Int?
  sellerId        Int?
  observations    String?
  expiresAt       DateTime?
  convertedSaleId Int?            @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  convertedSale   Sale?           @relation(fields: [convertedSaleId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  priceList       PriceList?      @relation(fields: [priceListId], references: [id])
  seller          User?           @relation("QuotationSeller", fields: [sellerId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  user            User            @relation("QuotationCreator", fields: [userId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  items           QuotationItem[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
}

model QuotationItem {
  id             Int          @id @default(autoincrement())
  quotationId    Int
  productId      Int
  quantity       Int
  price          Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(12, 2)
  lineSubtotal   Decimal      @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal      @default(0)
  lineTotal      Decimal      @default(0)
  priceListId    Int?
  product        Product      @relation(fields: [productId], references: [id])
  quotation      Quotation    @relation(fields: [quotationId], references: [id])
}

enum QuotationStatus {
  PENDING
  REJECTED
  EXPIRED
  CONVERTED
}

enum RemissionStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum CommissionType {
  SALE
  REVERSAL
}

enum Role {
  ADMIN
  USER
  SELLER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  ACTIVE
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AccountStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

enum PriceMode {
  TAX_INCLUDED
  TAX_EXCLUDED
}
